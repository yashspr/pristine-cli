#!/bin/bash
# Pristine fork entrypoint. Same command surface as `mole` / `mo`.
# Fork-only file; see CHANGES-FORK.md.

set -euo pipefail

# Brand the native admin-password dialog (lib/core/sudo.sh).
export PRISTINE_DIALOG_TITLE="${PRISTINE_DIALOG_TITLE:-Pristine}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/mole" "$@"
